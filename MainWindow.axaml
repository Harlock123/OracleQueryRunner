<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lawgrid="clr-namespace:LAWgrid;assembly=LAWgrid"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
        x:Class="OracleQueryRunner.MainWindow"
        Title="Oracle Query Runner"
        Width="1000" Height="700"
        MinWidth="600" MinHeight="400">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Connection String Section -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Connection String:"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"
                       FontWeight="Bold"/>
            <TextBox Grid.Column="1"
                     Name="ConnectionStringTextBox"
                     Watermark="Data Source=myserver:1521/ORCL;User Id=username;Password=password;"
                     PasswordChar="●"
                     RevealPassword="False"/>
            <ToggleButton Grid.Column="2"
                          Name="ShowPasswordToggle"
                          Content="Show"
                          Margin="5,0,0,0"
                          Click="ShowPasswordToggle_Click"/>
        </Grid>

        <!-- Query Label -->
        <TextBlock Grid.Row="1"
                   Text="SQL Query:"
                   FontWeight="Bold"
                   Margin="0,0,0,5"/>

        <!-- Query TextBox -->
        <TextBox Grid.Row="2"
                 Name="QueryTextBox"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 Watermark="Enter your Oracle SQL query here..."
                 FontFamily="Consolas, Menlo, Monaco, monospace"/>

        <!-- Buttons Section -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    Margin="0,10,0,10">
            <Button Name="ExecuteButton"
                    Content="Execute Query"
                    Click="ExecuteButton_Click"
                    Padding="20,8"
                    FontWeight="Bold"/>
            <Button Name="ClearButton"
                    Content="Clear Results"
                    Click="ClearButton_Click"
                    Margin="10,0,0,0"
                    Padding="20,8"/>
            <Button Name="SaveSettingsButton"
                    Content="Save Connection"
                    Click="SaveSettingsButton_Click"
                    Margin="10,0,0,0"
                    Padding="20,8"/>
        </StackPanel>

        <!-- Results Grid -->
        <lawgrid:LAWgrid Grid.Row="4"
                         Name="ResultsGrid"
                         GridTitle="Query Results"/>

        <!-- Status Bar -->
        <Border Grid.Row="5"
                Background="#404040"
                
                Padding="10,5"
                Margin="0,10,0,0"
                CornerRadius="3">
            <TextBlock Name="StatusText"
                       Text="Ready"/>
        </Border>
    </Grid>
</Window>
