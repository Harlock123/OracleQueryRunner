<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lawgrid="clr-namespace:LAWgrid;assembly=LAWgrid"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
        x:Class="OracleQueryRunner.MainWindow"
        Title="Oracle Query Runner"
        Width="1200" Height="700"
        MinWidth="800" MinHeight="400">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" MinWidth="150" MaxWidth="500"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel - Table List -->
        <Border Grid.Column="0"
                BorderBrush="#606060"
                BorderThickness="1"
                CornerRadius="3"
                Margin="0,0,10,0"
                Padding="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0"
                        Name="FetchTablesButton"
                        Content="Fetch Tables"
                        Click="FetchTablesButton_Click"
                        HorizontalAlignment="Stretch"
                        Padding="10,8"
                        Margin="0,0,0,5"/>

                <ListBox Grid.Row="1"
                         Name="TablesListBox"
                         SelectionChanged="TablesListBox_SelectionChanged"/>
            </Grid>
        </Border>

        <!-- Grid Splitter -->
        <GridSplitter Grid.Column="1"
                      Width="5"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch"
                      Background="#404040"/>

        <!-- Right Panel - Main Content -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="150"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <!-- Connection Buttons Section -->
        <Border Grid.Row="0"
                BorderBrush="#606060"
                BorderThickness="1"
                CornerRadius="3"
                Padding="10"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Name="ConnButton1" Click="ConnButton_Click"
                        Margin="0,0,5,0" Padding="10,8" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Name="ConnCheck1" IsChecked="False" IsHitTestVisible="False" Margin="0,0,5,0"/>
                        <TextBlock Name="ConnLabel1" Text="Connection 1"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="1" Name="ConnButton2" Click="ConnButton_Click"
                        Margin="5,0,5,0" Padding="10,8" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Name="ConnCheck2" IsChecked="False" IsHitTestVisible="False" Margin="0,0,5,0"/>
                        <TextBlock Name="ConnLabel2" Text="Connection 2"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" Name="ConnButton3" Click="ConnButton_Click"
                        Margin="5,0,5,0" Padding="10,8" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Name="ConnCheck3" IsChecked="False" IsHitTestVisible="False" Margin="0,0,5,0"/>
                        <TextBlock Name="ConnLabel3" Text="Connection 3"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="3" Name="ConnButton4" Click="ConnButton_Click"
                        Margin="5,0,0,0" Padding="10,8" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Name="ConnCheck4" IsChecked="False" IsHitTestVisible="False" Margin="0,0,5,0"/>
                        <TextBlock Name="ConnLabel4" Text="Connection 4"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Query Label -->
        <TextBlock Grid.Row="1"
                   Text="SQL Query:"
                   FontWeight="Bold"
                   Margin="0,0,0,5"/>

        <!-- Query TextBox -->
        <TextBox Grid.Row="2"
                 Name="QueryTextBox"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 Watermark="Enter your Oracle SQL query here..."
                 FontFamily="Consolas, Menlo, Monaco, monospace"/>

        <!-- Buttons Section -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    Margin="0,10,0,10">
            <Button Name="ExecuteButton"
                    Content="Execute Query"
                    Click="ExecuteButton_Click"
                    Padding="20,8"
                    FontWeight="Bold"/>
            <Button Name="ClearButton"
                    Content="Clear Results"
                    Click="ClearButton_Click"
                    Margin="10,0,0,0"
                    Padding="20,8"/>
        </StackPanel>

        <!-- Results Grid -->
        <lawgrid:LAWgrid Grid.Row="4"
                         Name="ResultsGrid"
                         GridTitle="Query Results"/>

        <!-- Status Bar -->
        <Border Grid.Row="5"
                Background="#404040"

                Padding="10,5"
                Margin="0,10,0,0"
                CornerRadius="3">
            <TextBlock Name="StatusText"
                       Text="Ready"/>
        </Border>
        </Grid>
    </Grid>
</Window>
